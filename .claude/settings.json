{
  "permissions": {
    "allow": [
      "Bash(npx vitest run *)",
      "Bash(rtk npx vitest run *)",
      "Bash(npx vitest related *)",
      "Bash(rtk npx vitest related *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit *)",
      "Bash(rtk npx tsc --noEmit)",
      "Bash(rtk npx tsc --noEmit *)",
      "Bash(npx prettier --check *)",
      "Bash(rtk npx prettier --check *)",
      "Bash(npm run docs:check)",
      "Bash(npm run docs:check *)",
      "Bash(rtk npm run docs:check)",
      "Bash(rtk npm run docs:check *)",
      "Bash(npm run changelog:check)",
      "Bash(rtk npm run changelog:check)",
      "Bash(npm run typecheck)",
      "Bash(rtk npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(rtk npm run lint)",
      "Bash(npm run rule *)",
      "Bash(rtk npm run rule *)",
      "Bash(npm run card:get *)",
      "Bash(rtk npm run card:get *)",
      "Bash(rtk git status)",
      "Bash(rtk git status *)",
      "Bash(rtk git diff)",
      "Bash(rtk git diff *)",
      "Bash(rtk git branch)",
      "Bash(rtk git branch *)",
      "Bash(rtk git log)",
      "Bash(rtk git log *)",
      "Bash(rtk git show *)",
      "PowerShell(npx vitest run *)",
      "PowerShell(rtk npx vitest run *)",
      "PowerShell(npx vitest related *)",
      "PowerShell(rtk npx vitest related *)",
      "PowerShell(npx tsc --noEmit)",
      "PowerShell(npx tsc --noEmit *)",
      "PowerShell(rtk npx tsc --noEmit)",
      "PowerShell(rtk npx tsc --noEmit *)",
      "PowerShell(npx prettier --check *)",
      "PowerShell(rtk npx prettier --check *)",
      "PowerShell(npm run docs:check)",
      "PowerShell(npm run docs:check *)",
      "PowerShell(rtk npm run docs:check)",
      "PowerShell(rtk npm run docs:check *)",
      "PowerShell(npm run changelog:check)",
      "PowerShell(rtk npm run changelog:check)",
      "PowerShell(npm run typecheck)",
      "PowerShell(rtk npm run typecheck)",
      "PowerShell(npm run lint)",
      "PowerShell(rtk npm run lint)",
      "PowerShell(npm run rule *)",
      "PowerShell(rtk npm run rule *)",
      "PowerShell(npm run card:get *)",
      "PowerShell(rtk npm run card:get *)",
      "PowerShell(rtk git status)",
      "PowerShell(rtk git status *)",
      "PowerShell(rtk git diff)",
      "PowerShell(rtk git diff *)",
      "PowerShell(rtk git branch)",
      "PowerShell(rtk git branch *)",
      "PowerShell(rtk git log)",
      "PowerShell(rtk git log *)",
      "PowerShell(rtk git show *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/adhd-default.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-audit-comment.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-skipped-tests.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-bulk-git-add.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-report-delete.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-gamestate-upload.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-pack-order.mjs\""
          }
        ]
      }
    ]
  }
}

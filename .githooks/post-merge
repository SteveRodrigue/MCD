#!/usr/bin/env sh

# Ensure Node/npm are available in PATH (critical for VS Code GUI / Git clients on Windows & macOS)
if ! command -v npm >/dev/null 2>&1; then
  export PATH="/c/Program Files/nodejs:/c/Program Files (x86)/nodejs:$APPDATA/npm:$LOCALAPPDATA/Programs/nodejs:/usr/local/bin:/opt/homebrew/bin:$PATH"
fi

NPM="npm"
if ! command -v "$NPM" >/dev/null 2>&1 && command -v npm.cmd >/dev/null 2>&1; then
  NPM="npm.cmd"
fi

# Detect whether package-lock.json changed in the merged commits
if git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null | grep -Eq '(^|/)package-lock\.json$'; then
  echo "📦 package-lock.json changed after merge. Running npm install to sync dependencies..."
  "$NPM" install
fi


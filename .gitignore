cache/
cache/**
/cache/
/cache/**
/stats/
/stats/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

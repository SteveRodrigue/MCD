{
  "name": "marvel-champions-digital",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "An open-source digital implementation of Marvel Champions: The Card Game",
  "license": "MIT",
  "scripts": {
    "dev": "npm run schema:generate && tsx scripts/dev-server-with-log.ts",
    "build": "npm run schema:generate && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "simulate": "tsx scripts/simulate-games.ts",
    "cache:cards": "tsx scripts/cache-card-images.ts",
    "report:declarations": "tsx tools/audit/supplemental-declarations-analyzer.ts",
    "audit:import-cycles": "tsx tools/audit/import-cycles.ts",
    "docs:check": "tsx tools/audit/docs-check.ts",
    "docs:fonts": "tsx tools/audit/fonts-record.ts",
    "audit:schema-engine": "tsx tools/audit/schema-engine-coverage.ts",
    "card:get": "tsx tools/audit/get-card-data.ts",
    "card:extract": "tsx scripts/extract-card.ts",
    "card:validate": "tsx scripts/validate-card.ts",
    "parse:card": "tsx tools/audit/card-text-parser.ts",
    "schema:generate": "tsx tools/generate-supplemental-schema.ts",
    "rule": "tsx scripts/lookup-rule.ts",
    "changelog:release": "tsx scripts/changelog-release.ts",
    "changelog:check": "tsx scripts/changelog-release.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests tools scripts --report-unused-disable-directives --max-warnings 0",
    "deadcode": "knip",
    "format": "prettier --write \"**/*.{ts,tsx,js}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js}\"",
    "verify": "npm run schema:generate && npm run format:check && npm run lint && npm run typecheck && npm run docs:check && npm test && npm run test:coverage && npm run build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/boogaloo": "^5.3.0",
    "@fontsource/comic-relief": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "immer": "^11.2.3",
    "lucide-react": "^0.436.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.42.0",
    "postcss": "^8.4.41",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}

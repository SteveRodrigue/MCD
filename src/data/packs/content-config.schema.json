{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marvel Champions Digital - Content Config",
  "description": "Which packs the game loads (content/config.json).",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "enabledPacks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "enabledPacks"
  ],
  "additionalProperties": false
}

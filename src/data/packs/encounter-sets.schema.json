{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marvel Champions Digital - Encounter Sets",
  "description": "Catalog of modular, standard and expert encounter sets (encounter-sets.json) provided by a pack.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "kind": {
        "type": "string",
        "enum": [
          "modular",
          "standard",
          "expert"
        ]
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string"
      }
    },
    "required": [
      "code",
      "kind",
      "name",
      "description"
    ],
    "additionalProperties": false
  }
}

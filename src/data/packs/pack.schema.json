{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marvel Champions Digital - Content Pack Manifest",
  "description": "Manifest (pack.json) of a content pack: identity, origin, API version and dependencies.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,31}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "core",
        "hero",
        "scenario",
        "campaign",
        "mixed"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "official-bundled",
        "official-sync",
        "user"
      ]
    },
    "apiVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "dependsOn": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "origin",
    "apiVersion",
    "version",
    "dependsOn"
  ],
  "additionalProperties": false
}

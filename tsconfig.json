{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting / Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path Aliases (resolved relative to tsconfig location) */
    "paths": {
      "@engine/*": ["./src/engine/*"],
      "@data/*": ["./src/data/*"],
      "@ui/*": ["./src/ui/*"],
      "@assets/*": ["./src/assets/*"]
    }
  },
  "include": ["src", "tests", "tools", "scripts", "vite.config.ts", "vitest.config.ts"]
}
